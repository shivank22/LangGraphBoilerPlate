# --- Required ---
OPENAI_API_KEY=sk-replace-me

# --- Model ---
MODEL_NAME=gpt-5.2
TEMPERATURE=0.2

# --- Persistence ---
# Relative to the project root. Created automatically on first run.
DB_PATH=data/checkpoints.sqlite

# --- Behavior ---
SYSTEM_PROMPT=You are a helpful, concise assistant. Use the tools available to you when relevant, and explain your reasoning briefly.

# --- Guardrails (comma-separated where applicable) ---
MAX_ITERATIONS=8
MAX_INPUT_CHARS=8000
GUARDRAIL_BLOCKLIST=

# --- Human-in-the-loop ---
# Comma-separated tool names that should pause for approval before executing.
HITL_TOOLS=get_weather

# --- Logging ---
LOG_LEVEL=INFO
